  expected_students                                    Int                           @default(0)
  expected_parents                                     Int                           @default(0)
  expected_staff                                       Int                           @default(0)
  code_change_count                                    String                        @default("0")
  pending_code_change_at                               DateTime?                     @db.Timestamptz(6)
  attendance                                           attendance[]
