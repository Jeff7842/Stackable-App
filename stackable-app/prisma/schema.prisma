generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attendance {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_type      String
  user_id        String    @db.Uuid
  school_id      String    @db.Uuid
  school_name    String
  school_no      BigInt
  clock_in       DateTime  @default(now()) @db.Timestamptz(6)
  clock_out      DateTime? @db.Timestamptz(6)
  status         String    @default("present")
  remarks        String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  reference_code String    @unique
  schools        schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_school_fk")

  @@index([clock_in], map: "idx_attendance_clock_in")
  @@index([school_id], map: "idx_attendance_school_id")
  @@index([user_id], map: "idx_attendance_user_id")
  @@index([user_type], map: "idx_attendance_user_type")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model class_attendance {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id         String    @db.Uuid
  date             DateTime  @db.Date
  students_present Int
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  classes          classes   @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_class_fk")

  @@unique([class_id, date], map: "class_date_unique")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model class_subject_performance {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id          String           @db.Uuid
  subject_id        BigInt
  average_score     Decimal?         @db.Decimal(5, 2)
  average_grade     String?
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  school_subject_id String?          @db.Uuid
  classes           classes          @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "class_perf_class_fk")
  subjects          subjects         @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "class_perf_subject_fk")
  school_subjects   school_subjects? @relation(fields: [school_subject_id], references: [id], onUpdate: NoAction, map: "class_subject_performance_school_subject_fk")

  @@unique([class_id, subject_id], map: "class_subject_unique")
  @@index([school_subject_id], map: "idx_class_subject_performance_school_subject_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model classes {
  id                                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                                   String                        @db.Uuid
  class_name                                  String
  stream                                      String?
  class_teacher_id                            String?                       @db.Uuid
  class_prefect_id                            String?                       @db.Uuid
  total_students                              Int?                          @default(0)
  students_present_today                      Int?                          @default(0)
  position_in_stream                          Int?
  position_overall                            Int?
  class_performance                           Decimal?                      @db.Decimal(5, 2)
  created_at                                  DateTime?                     @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime?                     @default(now()) @db.Timestamptz(6)
  teacher_id                                  String?                       @db.Uuid
  assessment_targets                          assessment_targets[]
  class_attendance                            class_attendance[]
  class_subject_performance                   class_subject_performance[]
  schools                                     schools                       @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "classes_school_fk")
  teachers_classes_class_teacher_idToteachers teachers?                     @relation("classes_class_teacher_idToteachers", fields: [class_teacher_id], references: [id], onUpdate: NoAction, map: "classes_teacher_fk")
  teachers_classes_teacher_idToteachers       teachers?                     @relation("classes_teacher_idToteachers", fields: [teacher_id], references: [id], onUpdate: NoAction)
  grading_reports                             grading_reports[]
  school_subject_classes                      school_subject_classes[]
  students                                    students[]
  teacher_student_assignments                 teacher_student_assignments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model grading_reports {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String           @db.Uuid
  subject_id        BigInt
  term              String
  class_id          String           @db.Uuid
  grade             String
  teacher_id        String           @db.Uuid
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  school_subject_id String?          @db.Uuid
  raw_score         Decimal?         @db.Decimal(6, 2)
  normalized_pct    Decimal?         @db.Decimal(6, 2)
  remarks           String?
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  classes           classes          @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_gr_class")
  subjects          subjects         @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_gr_subject")
  teachers          teachers         @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_gr_teacher")
  school_subjects   school_subjects? @relation(fields: [school_subject_id], references: [id], onUpdate: NoAction, map: "grading_reports_school_subject_fk")

  @@index([school_subject_id], map: "idx_grading_reports_school_subject_id")
  @@index([student_id, subject_id, term], map: "idx_grading_reports_student_subject_term")
  @@index([subject_id, class_id, term], map: "idx_grading_reports_subject_class_term")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model parent {
  id                                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
