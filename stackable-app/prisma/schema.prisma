  schoolId         String?  @db.Uuid
  role             String?
  schoolCode       String?
  status           String?  @default("active")
  mustChangePassword Boolean @default(false)
  twoFactorEnabled Boolean  @default(false)

  accounts   ba_account[]
  sessions   ba_session[]
  twoFactors ba_two_factor[]

  @@map("ba_users")
}

model ba_account {
  id            String    @id
  accountId     String
  providerId    String
  userId        String
  accessToken   String?
  refreshToken  String?
  idToken       String?
  expiresAt     DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  user ba_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ba_accounts")
}

model ba_session {
  id        String   @id
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user ba_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Not @unique: adding a unique constraint via `prisma db push` requires
  // --accept-data-loss, which this environment blocks by policy even on an
  // empty table. Lookups still need to be fast, and Better Auth's own
  // 32-char random tokens make collisions cryptographically negligible.
  @@index([token], map: "idx_ba_sessions_token")
  @@map("ba_sessions")
}

model ba_verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ba_verifications")
}

