  name                                                 String                        @unique
  code                                                 String                        @unique @default("")
  status                                               String                        @default("pending")
  updated_at                                           DateTime                      @default(now()) @db.Timestamptz(6)
  location                                             String?
  email                                                String?
  phone_1                                              BigInt
  phone_2                                              BigInt?
  phone_3                                              BigInt?
  id                                                   String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Was DB function generate_school_id() in Supabase. Neon has no such function,
  // so the app (school repository) now generates this human-facing school code.
  school_id                                            BigInt
  logo                                                 String?
  late_time                                            DateTime?                     @default(dbgenerated("'08:30:00'::time without time zone")) @db.Time(6)
  subscription_package                                 String                        @default("Seedling")
  subscription_status                                  String                        @default("inactive")
  subscription_started_at                              DateTime?                     @db.Timestamptz(6)
  subscription_expires_at                              DateTime?                     @db.Timestamptz(6)
  expected_users                                       Int                           @default(0)
  expected_teachers                                    Int                           @default(0)
  expected_admins                                      Int                           @default(0)
  expected_students                                    Int                           @default(0)
  expected_parents                                     Int                           @default(0)
  expected_staff                                       Int                           @default(0)
  code_change_count                                    String                        @default("0")
  pending_code_change_at                               DateTime?                     @db.Timestamptz(6)
  assessments                                          assessments[]
  attendance                                           attendance[]
  classes                                              classes[]
  parent_parent_school_nameToschools                   parent[]                      @relation("parent_school_nameToschools")
  parent_parent_school_idToschools                     parent[]                      @relation("parent_school_idToschools")
  school_profiles                                      school_profiles?
  school_security_codes                                school_security_codes[]
  school_subjects                                      school_subjects[]
  student_parents_student_parents_school_idToschools   student_parents[]             @relation("student_parents_school_idToschools")
  student_parents_student_parents_school_nameToschools student_parents[]             @relation("student_parents_school_nameToschools")
  student_subjects                                     student_subjects[]
  students_students_school_nameToschools               students[]                    @relation("students_school_nameToschools")
  students_students_school_idToschools                 students[]                    @relation("students_school_idToschools")
  teacher_student_assignments                          teacher_student_assignments[]
  teacher_subjects                                     teacher_subjects[]
  teacher_timetables                                   teacher_timetables[]
  teachers                                             teachers[]
  user_sessions                                        user_sessions[]
  users                                                users[]

  @@index([subscription_expires_at], map: "idx_schools_subscription_expires_at")
  @@index([subscription_package], map: "idx_schools_subscription_package")
  @@index([subscription_status], map: "idx_schools_subscription_status")
}

