  school_subjects                                      school_subjects[]
  student_parents_student_parents_school_idToschools   student_parents[]             @relation("student_parents_school_idToschools")
  student_parents_student_parents_school_nameToschools student_parents[]             @relation("student_parents_school_nameToschools")
  student_subjects                                     student_subjects[]
  students_students_school_nameToschools               students[]                    @relation("students_school_nameToschools")
  students_students_school_idToschools                 students[]                    @relation("students_school_idToschools")
