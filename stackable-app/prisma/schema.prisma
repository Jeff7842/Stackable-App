  alternate_phone                     String?
  message_count                       Int               @default(0)
  status                              String            @default("active")
  created_at                          DateTime          @default(now()) @db.Timestamptz(6)
  schools_parent_school_nameToschools schools           @relation("parent_school_nameToschools", fields: [school_name], references: [name], onDelete: Cascade, onUpdate: NoAction, map: "name_school_fk")
  schools_parent_school_idToschools   schools           @relation("parent_school_idToschools", fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "parents_school_fk")
  users                               users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "parents_user_fk")
  student_parents                     student_parents[]

  @@unique([school_id, phone], map: "parents_phone_school_unique")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model school_profiles {
  school_id  String   @id @db.Uuid
  head_name  String?
