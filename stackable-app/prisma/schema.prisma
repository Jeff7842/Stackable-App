  reset_token_hash String?
  token_expires_at DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  ip_address       String?   @db.Inet
  user_agent       String?
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_resets_user_fk")

  @@index([reset_token_hash], map: "idx_password_resets_reset_token_hash")
  @@index([user_id, created_at(sort: Desc)], map: "idx_password_resets_user_id_created_at")
}

